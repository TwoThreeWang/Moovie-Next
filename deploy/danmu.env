# 只传弹幕服务需要的参数；令牌和代理从根目录 .env 或宿主机环境解析。
TOKEN=${DANMU_API_TOKEN:-changeme}
# 请求都来自网站的同一个内网 IP，访客限流由网站负责。
RATE_LIMIT_MAX_REQUESTS=0
COMMENT_CACHE_MINUTES=60
SEARCH_CACHE_MINUTES=30
DANMU_LIMIT=5
LIKE_SWITCH=false
LOG_LEVEL=warn
TZ=Asia/Shanghai
HTTP_PROXY=${OUTBOUND_PROXY-socks5://cloudflare-warp:1080}
HTTPS_PROXY=${OUTBOUND_PROXY-socks5://cloudflare-warp:1080}
NO_PROXY=localhost,127.0.0.1,postgres,ollama
