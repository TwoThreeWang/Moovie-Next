{
  "manifest_version": 3,
  "name": "影牛 Moovie 豆瓣助手",
  "short_name": "影牛",
  "version": "1.0.0",
  "description": "用你自己的豆瓣登录状态同步想看和看过；在豆瓣电影页显示影牛卡片和海报角标；豆列导入片单；备份豆瓣标记。",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "影牛", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "cookies", "notifications", "declarativeNetRequestWithHostAccess"],
  "web_accessible_resources": [{ "resources": ["icons/icon-32.png"], "matches": ["https://movie.douban.com/*"] }],
  "host_permissions": ["https://*.douban.com/*", "http://localhost:5200/*"],
  "content_scripts": [
    { "matches": ["http://localhost:5200/*"], "js": ["content/moovie.js"], "run_at": "document_start" },
    {
      "matches": ["https://movie.douban.com/*"],
      "js": ["content/shared.js", "content/badges.js", "content/subject.js"],
      "css": ["content/douban.css"]
    },
    {
      "matches": ["https://www.douban.com/doulist/*"],
      "js": ["content/shared.js", "content/badges.js", "content/doulist.js"],
      "css": ["content/douban.css"]
    },
    {
      "matches": ["https://search.douban.com/movie/*", "https://www.douban.com/people/*"],
      "js": ["content/shared.js", "content/badges.js"],
      "css": ["content/douban.css"]
    }
  ]
}
